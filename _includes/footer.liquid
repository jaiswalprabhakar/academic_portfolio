{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}
{% capture footer_cat %}
  <div class="footer-cat" aria-hidden="true">
    <svg viewBox="0 0 100 60" xmlns="http://www.w3.org/2000/svg">
      <polygon points="30,18 38,2 46,18" fill="var(--global-theme-color)" />
      <polygon points="54,18 62,2 70,18" fill="var(--global-theme-color)" />
      <ellipse cx="50" cy="34" rx="26" ry="22" fill="var(--global-theme-color)" />
      <ellipse cx="50" cy="40" rx="16" ry="12" fill="var(--global-bg-color)" opacity="0.15" />
      <ellipse cx="40" cy="30" rx="3" ry="4" fill="var(--global-bg-color)" />
      <ellipse cx="60" cy="30" rx="3" ry="4" fill="var(--global-bg-color)" />
      <polygon points="50,38 46,42 54,42" fill="var(--global-bg-color)" />
      <path class="footer-cat-tail" d="M 82 55 Q 100 45 92 25" stroke="var(--global-theme-color)"
        stroke-width="6" fill="none" stroke-linecap="round" />
    </svg>
  </div>
{% endcapture %}
{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    {{ footer_cat }}
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {{ footer_cat }}
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}
    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}